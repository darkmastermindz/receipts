{
  "name": "BOB Returns",
  "short_name": "Returns",
  "description": "Track BOB build receipts and returns by shop. Reads line items from photos on your device; strips metadata and redacts personal info.",
  "id": "./",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f5",
  "theme_color": "#1f5f6b",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Scan receipt", "url": "./#/add/purchase" },
    { "name": "To return", "url": "./#/todo" }
  ]
}
